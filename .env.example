# ---------------------------------------------------------------------------
# Neon Postgres (required)
# Use the *pooled* connection string from the Neon console
# (Dashboard → Connect → "Pooled connection", host contains "-pooler").
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxxxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Optional: cap the number of pool connections per serverless instance
PGPOOL_MAX=3

# ---------------------------------------------------------------------------
# Admin access (required for upload / save / delete / purge)
# The browser no longer contains the passcode — it posts it once and receives
# an HttpOnly, signed session cookie.
# ---------------------------------------------------------------------------
ADMIN_PASSCODE=change-me-to-something-long

# Optional: secret used to sign the session cookie.
# If unset, ADMIN_PASSCODE is used. Rotating it logs everyone out.
# ADMIN_SESSION_SECRET=
# Session lifetime is 8 hours.

# ---------------------------------------------------------------------------
# One-off legacy migration (only needed for `npm run db:migrate -- --from-supabase`)
# The current app does NOT read these; they exist purely to pull old data out
# of Supabase. Delete them once the migration is verified.
#
# Supabase dashboard -> Project Settings -> API:
#   Project URL          -> SUPABASE_URL
#   service_role secret  -> SUPABASE_SERVICE_ROLE_KEY   (not the anon key)
#
# Uncomment BOTH lines and fill them in, then:
#   npm run db:migrate -- --from-supabase --dry-run
#
# Prefer not to use keys? Either point SUPABASE_DB_URL at the Supabase database
# and use --from-postgres, or export the table with the SQL editor and use
# --file. See MIGRATION.md section 2.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role secret>
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

{
  "name": "attrition",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "predev": "node scripts/preflight.mjs",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "prestart": "node scripts/preflight.mjs",
    "build": "vite build",
    "prebuild": "node scripts/preflight.mjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/parseRegister.test.ts tests/repo.test.ts tests/migrate.test.ts tests/upload-flow.test.ts",
    "pretest": "node scripts/preflight.mjs",
    "db:setup": "tsx scripts/setup-db.ts",
    "predb:setup": "node scripts/preflight.mjs",
    "db:migrate": "tsx scripts/migrate-data.ts",
    "predb:migrate": "node scripts/preflight.mjs",
    "dev:db": "tsx scripts/dev-db.ts",
    "predev:db": "node scripts/preflight.mjs",
    "db:demo": "tsx scripts/setup-db.ts && tsx scripts/migrate-data.ts --file db/demo-seed.json",
    "predb:demo": "node scripts/preflight.mjs",
    "sample:register": "tsx scripts/make-sample-register.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.6",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "description": "Monthly headcount & attrition reporting for INVNT Cape Town and ALPHA, backed by Neon Postgres."
}
